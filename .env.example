# Porta em que o backend (que também serve o frontend) escuta.
PORT=3001

# Base da API upstream (sem o path).
PAINEL_API_BASE_URL=https://10.1.1.220

# Token de autorização enviado no header Authorization para a API upstream.
# NUNCA commitar o valor real — apenas em .env local ou nos secrets do servidor.
PAINEL_API_TOKEN=

PAINEL_COD_EMPRESA=1
PAINEL_TIPO_MONITOR=PESAGEMFINA

# De quanto em quanto tempo (minutos) o backend consulta a API upstream e
# atualiza o painel. O frontend usa esse mesmo valor (via GET /api/config).
PAINEL_REFRESH_INTERVAL_MINUTES=5

# O certificado TLS da API upstream é self-signed (confirmado: só funciona
# com `curl -k`). Deixe "false" a menos que isso mude.
PAINEL_API_TLS_REJECT_UNAUTHORIZED=false
